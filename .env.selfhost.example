# Config for docker-compose.selfhost.yml - copy this file to .env.selfhost
# and fill it in, then:
#
#   docker compose -f docker-compose.selfhost.yml --env-file .env.selfhost up -d
#
# Variables marked "required" make `docker compose up` fail fast with a
# clear message if you forget them, rather than silently starting with a
# wrong or insecure value.

# Required. Becomes part of every user's identity (@user:domain) and is
# advertised to other homeservers for federation - pick the real domain
# you're deploying to. It cannot be changed later without breaking every
# existing user id.
SERVER_DOMAIN=chat.example.com

# Optional, shown in the client UI.
SERVER_NAME=My Chat Server

# Required. Used for both Postgres's own password and the server's
# DATABASE_URL (built automatically in docker-compose.selfhost.yml) -
# generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Required, and must differ from each other. Generate with:
#   openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional. Set to false after creating your own account(s) if you don't
# want this instance open to anyone who finds it.
REGISTRATION_ENABLED=true

# Required. The client's real, externally-reachable origin (scheme + host
# + port, no path, no trailing slash) - becomes the server's CORS_ORIGIN.
# Must match exactly what's in a browser's address bar, or every API call
# will fail CORS.
CLIENT_PUBLIC_URL=https://chat.example.com

# Optional - further browser origins allowed to call this server, comma-separated,
# each a bare origin (scheme + host + port, no path). The usual reason is the
# desktop app, which is not served from CLIENT_PUBLIC_URL: on Windows its origin is
# http://tauri.localhost. Leave unset if only the web client above uses this server.
# CORS_EXTRA_ORIGINS=http://tauri.localhost

# Required. This server's real, externally-reachable origin - becomes the
# server's PUBLIC_BASE_URL (what it advertises to other homeservers for
# federation) and the client's API_URL (what the browser calls directly -
# nothing in this compose file proxies API traffic through the client's
# nginx). Put a reverse proxy (nginx/Caddy/Traefik) in front yourself for
# TLS; that's outside what this compose file sets up.
SERVER_PUBLIC_URL=https://api.chat.example.com

# Optional - which image tag to pull. "latest" tracks the newest release;
# pin an exact version (e.g. "0.5.1") to upgrade deliberately instead.
IMAGE_TAG=latest

# Optional - host ports. Change if either default is already taken on this
# machine.
SERVER_PORT=4000
CLIENT_PORT=8080

# Optional - how many reverse proxies (nginx, Caddy, Traefik, ...) sit between the
# internet and the server. Set it to 1 when you put one in front, as recommended
# for TLS: without it the server sees only the proxy's address and every user shares
# ONE rate-limit bucket (10 login/register attempts per 15 minutes for everyone).
# Leave unset if clients connect to SERVER_PORT directly. A hop count or a
# comma-separated list of proxy addresses/CIDRs; "true" is refused on purpose.
# TRUST_PROXY=1

# Optional. Set to false to make this a PRIVATE server that does not talk to other homeservers at all: it
# answers no federation request, sends nothing, and nobody on it can add, message or join anyone on another
# server. Existing relationships with other servers are kept and resume if you set it back to true. Only
# true/false are accepted. See docs/deployment/private-server.md.
# FEDERATION_ENABLED=false

# Optional. Limit WHICH other servers this one talks to (comma-separated exact domains, no wildcards, no https://).
# ALLOWED: only these servers, no others (for example just your family's). BLOCKED: every server except these.
# A server that is not permitted is neither answered nor contacted; what already exists with it is kept and waits.
# Unset or empty = no limit. A domain in both lists, or a malformed entry, stops the server at startup.
# See docs/deployment/private-server.md.
# FEDERATION_ALLOWED_DOMAINS=family.example.com
# FEDERATION_BLOCKED_DOMAINS=spam.example.com

# Optional - only takes effect when running with `--profile multi-replica`
# (see docs/scaling.md "Running multiple replicas"); the compose file's redis
# service doesn't start otherwise. Leave unset for a single server replica.
# REDIS_URL=redis://redis:6379
