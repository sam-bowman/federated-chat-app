# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Test coverage reports (generated - see "Testing" in docs/testing.md)
coverage/

# Env files - only the committed *.example templates carry real (dev-only)
# values; everything else here is machine-local.
.env
.env.local
.env.*.local
.env.a
.env.b
.env.selfhost
!.env.a.example
!.env.b.example
!.env.selfhost.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploaded user content (local filesystem storage - server/src/modules/media)
server/uploads/*
!server/uploads/.gitkeep
server/uploads-a/
server/uploads-b/
server/uploads-replica-a/
server/uploads-replica-b/
server/test-uploads/

# The Prisma client (Prisma 7 generates TypeScript source into the project, schema.prisma's `output`); `npm run prisma:generate --workspace server`
server/src/generated/

# Native binary build output (client/scripts/build-binary.mjs) - built
# on demand, platform-specific, published as release assets, not committed
client/dist-bin/
server/dist-bin/

# scripts/start*.ps1 PID files and logs
.run/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# End-to-end suite output (e2e/)
e2e/.data/
e2e/test-results/
e2e/playwright-report/
