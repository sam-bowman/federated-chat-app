{
  "name": "my-chat-app",
  "private": true,
  "version": "0.18.0",
  "description": "Federated open-source communication platform (MVP, single-server, federation-ready design)",
  "license": "MIT",
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "test:e2e": "npm run test --workspace e2e"
  }
}
