{
  "name": "my-chat-app",
  "private": true,
  "version": "0.2.0",
  "description": "Federated open-source communication platform (MVP, single-server, federation-ready design)",
  "license": "MIT",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres"
  }
}
