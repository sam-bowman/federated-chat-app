{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Chat App",
  "version": "0.14.0",
  "identifier": "com.sambowman.federatedchatapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "My Chat App",
        "width": 1100,
        "height": 750,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyRkNDNjY2NUE0NjI1RDgKUldUWUpVWmFac2I4Y3RhanRYcmJhZWZtdVlhQzFWQ2NPK0c1eTk3V0pJY0M1WlRtNnVFMnNiK3cK",
      "endpoints": [
        "https://github.com/sam-bowman/federated-chat-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
