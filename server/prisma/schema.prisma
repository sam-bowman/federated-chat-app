// Federated Open-Source Communication Platform — MVP schema
//
// Single-server for now, but the shapes here are chosen so federation can be
// added later without a rewrite:
//   - All federatable objects (User, Message, Community, Emoticon, ...) use
//     ULIDs as their public/protocol ID, never the implicit DB primary key
//     semantics of another server.
//   - Identity is `username` scoped to this server's configured `domain`
//     (see src/config.ts); the full federated identity is `@username:domain`.
//   - SyncEvent is a per-recipient outbox so clients (and, later, remote
//     homeservers) can resume delivery via a cursor instead of assuming
//     everyone is online.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/Linux-glibc). The Docker image
  // (server/Dockerfile) runs on Alpine, which Prisma's own OpenSSL
  // auto-detection doesn't handle there (Alpine has no `openssl` CLI to
  // shell out to) - without this explicit target, Prisma silently generates
  // a client against the wrong engine binary and the container fails at
  // startup with an opaque "Could not parse schema engine response" error.
  // Both musl targets are needed since the image is published for both
  // amd64 and arm64 (see .github/workflows/publish-images.yml) - omitting
  // the arm64 one would only fail at container startup on that arch, not
  // at build/generate time.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PresenceStatus {
  ONLINE
  AWAY
  BUSY
  DO_NOT_DISTURB
  INVISIBLE
  OFFLINE
}

enum CommunityVisibility {
  UNLISTED
  INVITE_ONLY
  LOCAL_ONLY
  PUBLIC
}

enum ContactPolicy {
  ANYONE
  SHARED_COMMUNITY
  LOCAL_ONLY
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ConversationType {
  DM
  GROUP
}

enum ChannelType {
  TEXT
  // A voice channel carries no messages: people join it and talk (LiveKit, see lib/voice.ts).
  VOICE
}

model User {
  id           String   @id @default(uuid())
  protocolId   String   @unique // ULID, set at creation time by application code
  username     String
  passwordHash String? // null for a remote stub - they authenticate on their own homeserver, not here
  displayName  String
  avatarUrl    String?
  bio          String?
  // Optional profile fields (lib/profileFields.ts validates them): plain-text pronouns, and an
  // accent colour as #rrggbb. A remote stub's are whatever its home server last told us.
  pronouns     String?
  accentColor  String?

  // Whether servers this one has no relationship with may find this person by handle (GET /federation/v1/users/:username,
  // a friend request, a conversation); when false they are told the person does not exist. The server's own setting
  // (FEDERATION_USER_DISCOVERABILITY) can only narrow it: see lib/userDiscoverability.ts. Meaningless for a remote stub.
  discoverable Boolean  @default(true)

  // Who may start something with this person (a friend request, a conversation): anyone, only people who share a community with
  // them, or only people on this server. Friends are always allowed. See lib/contactPolicy.ts. Meaningless for a remote stub.
  contactPolicy ContactPolicy @default(ANYONE)

  // Whether this person chose to be listed in the server's directory of people (DIRECTORY_ENABLED; lib/directory.ts). Off
  // unless they opt in, and only counts while they are also findable: hiding wins. Meaningless for a remote stub.
  listedInDirectory Boolean @default(false)

  // Which homeserver is authoritative for this identity. Every row has one -
  // a local user's is always `config.domain`; a remote stub's is the real
  // peer domain, cached here so `@username:domain` resolves without a join.
  homeserverDomain  String
  isRemote          Boolean @default(false)
  // Cached from the peer's discovery document when this stub was created -
  // lets us build absolute URLs for remote avatars/attachments, since a
  // relative `/uploads/x` only resolves against the server that stored it.
  homeserverBaseUrl String?

  presenceStatus PresenceStatus @default(OFFLINE)
  customStatus   String?
  lastSeenAt     DateTime?

  // TOTP (RFC 6238) 2FA - null/false for every remote stub and for a local
  // user who hasn't enabled it. Stored as plaintext base32 (not hashed, unlike
  // passwordHash) because the server needs to recompute codes from it on every
  // login - there's no KMS/secrets-vault in this project to do better than
  // that, same pragmatic tradeoff most self-hosted TOTP implementations make.
  totpSecret  String?
  totpEnabled Boolean @default(false)
  // The most recent 30-second time-step a valid code was accepted on, so the
  // exact same code (or a replayed recovery code) can't be accepted twice -
  // see server/src/lib/totp.ts.
  totpLastUsedStep Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  totpRecoveryCodes   TotpRecoveryCode[]
  sentFriendRequests  FriendRequest[]       @relation("SentFriendRequests")
  recvFriendRequests  FriendRequest[]       @relation("ReceivedFriendRequests")
  friendshipsA        Friendship[]          @relation("FriendshipUser")
  friendshipsB        Friendship[]          @relation("FriendshipFriend")
  notificationSettings NotificationSetting[]
  // The registration invite this account was made with (only on a server that asks for one); the invite is kept if it is deleted.
  registrationInviteId String?
  registrationInvite   RegistrationInvite? @relation(fields: [registrationInviteId], references: [id], onDelete: SetNull)
  blocksMade          Block[]               @relation("BlockingUser")
  blocksReceived       Block[]              @relation("BlockedUser")
  conversationMembers ConversationMember[]
  channelReads        ChannelRead[]
  messages            Message[]
  reactions           Reaction[]
  emoticonsCreated     Emoticon[]
  emoticonSaves        EmoticonSave[]
  ownedCommunities     Community[]
  invitesCreated       Invite[]
  communityMemberships CommunityMember[]
  syncEvents           SyncEvent[]

  @@unique([username, homeserverDomain])
  @@index([registrationInviteId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A one-time fallback code for logging in when the TOTP authenticator app
// isn't available. Hashed the same way RefreshToken.tokenHash is (sha256,
// one-way) - never stored or logged in plaintext after being shown once at
// generation time.
model TotpRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model FriendRequest {
  id          String              @id @default(uuid())
  protocolId  String              @unique
  fromUserId  String
  fromUser    User                @relation("SentFriendRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                @relation("ReceivedFriendRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  message     String?
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  resolvedAt  DateTime?

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockingUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Conversation {
  id         String           @id @default(uuid())
  protocolId String           @unique
  type       ConversationType
  title      String?
  createdAt  DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String?
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Community {
  id          String   @id @default(uuid())
  protocolId  String   @unique
  name        String
  description String?
  iconUrl     String?
  // The letters (1-3 characters) and background colour (#rrggbb) of the tile shown when there is no
  // picture; null means the default (the first two letters of the name). See src/lib/communityIcon.ts.
  iconText    String?
  iconColor   String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())

  // Which homeserver is authoritative for this community's membership,
  // roles, channels, and bans - mirrors User.homeserverDomain/isRemote
  // exactly. A local community's is always config.domain; a remote one's
  // (cached here after one of our local users joins a community hosted
  // elsewhere) is the real owning domain. A remote community's Channel/
  // CommunityMember rows are a read cache kept current via federation
  // relay - never independently authoritative the way a local community's
  // are. See protocol/federation.md's "Communities" section.
  homeserverDomain String
  isRemote         Boolean @default(false)

  // Who may join: UNLISTED (anyone with the community's id and server, as it always was), INVITE_ONLY (a valid Invite is
  // needed) or LOCAL_ONLY (only accounts on the home server; anyone else is told it does not exist). See
  // lib/communityVisibility.ts (PUBLIC is joinable like UNLISTED and also listed in the directory, if the server publishes
  // one: lib/directory.ts). Only meaningful on the home server; a remote community's is a cached copy of what the
  // home server said. This replaced the yes/no `openJoin`, which is still sent, derived, for older clients and servers.
  visibility CommunityVisibility @default(UNLISTED)

  members  CommunityMember[]
  roles    Role[]
  channels Channel[]
  bans     CommunityBan[]
  emoticons Emoticon[]
  invites   Invite[]
}

model Role {
  id          String   @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  position    Int      @default(0)
  permissions BigInt   @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  memberRoles MemberRole[]

  @@index([communityId])
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname    String?
  joinedAt    DateTime  @default(now())

  roles MemberRole[]

  @@unique([communityId, userId])
  @@index([userId])
}

model MemberRole {
  id       String          @id @default(uuid())
  memberId String
  member   CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
}

model CommunityBan {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

// A way into a community that can end: a code with an optional expiry and use limit, which its creator or a manager
// can revoke. Lives only on the community's home server, which is the one that checks it when someone joins (from
// this server or, over federation, from another). See src/lib/invites.ts.
model Invite {
  id          String    @id @default(uuid())
  // What is given out: random, 10 characters, no look-alikes. Unique across all communities.
  code        String    @unique
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  // Who made it. For someone on another server this is their cached stub (they minted it over federation).
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  // Made automatically for a card sent in a conversation (one per card, for that conversation's recipients), as
  // opposed to one a person made in the Invite dialog. The dialog's list leaves these out unless asked.
  viaCard     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
}

// A code that lets someone make an account on a server that is invite-only (REGISTRATION_INVITE_ONLY). Made by the operator
// with the registration-invites command, never through the API. Unrelated to community invites (Invite).
model RegistrationInvite {
  id        String    @id @default(uuid())
  // Random, 10 characters, no look-alikes (the same alphabet as a community invite).
  code      String    @unique
  // A reminder for the operator of who it is for. Never shown to the person using it.
  note      String?
  expiresAt DateTime?
  // null = no limit.
  maxUses   Int?
  uses      Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  users     User[]
}

model Channel {
  id          String      @id @default(uuid())
  protocolId  String      @unique
  communityId String
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  topic       String?
  type        ChannelType @default(TEXT)
  position    Int         @default(0)
  createdAt   DateTime    @default(now())

  messages Message[]
  reads    ChannelRead[]
}

// Per-(user, channel) read cursor, mirroring ConversationMember.lastReadAt -
// a community can have several channels, and a member may have read #general
// but not #random, so this can't live on CommunityMember.
model ChannelRead {
  id         String   @id @default(uuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  protocolId     String        @unique
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id])
  content        String
  // A community invitation (see src/lib/invite.ts), for a direct message that carries one; null otherwise.
  invite         Json?
  replyToId      String?
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  reactions   Reaction[]
  attachments Attachment[]

  @@index([conversationId, createdAt])
  @@index([channelId, createdAt])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // EXACTLY ONE of these two kinds (a CHECK in the migration says so): a Unicode emoji, or a custom emoticon
  // (`emoticonProtocolId`, the emoticon's own id on whichever server owns it). A custom reaction is shown to
  // everyone, so it carries a reference and not a `:trigger:`, which means different things to different people.
  emoji     String?
  emoticonProtocolId String?
  // Set when the emoticon is one of THIS server's own rows: the reaction goes when the emoticon is deleted, and
  // the name and picture are read live (so an edit shows). Null when it lives on another server, which sent
  // `emoticonName` and `emoticonImageUrl` (an absolute http(s) URL) to show it from, without storing the emoticon.
  emoticonId String?
  emoticon   Emoticon? @relation(fields: [emoticonId], references: [id], onDelete: Cascade)
  emoticonName     String?
  emoticonImageUrl String?
  createdAt DateTime @default(now())

  // Postgres treats NULLs as distinct, so each kind is unique on its own column.
  @@unique([messageId, userId, emoji])
  @@unique([messageId, userId, emoticonProtocolId])
}

model Attachment {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url         String
  filename    String
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}

model Emoticon {
  id          String   @id @default(uuid())
  protocolId  String   @unique
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  trigger     String
  imageUrl    String
  allowSave   Boolean  @default(true)
  allowExport Boolean  @default(true)
  allowFork   Boolean  @default(true)
  parentId    String?
  parent      Emoticon? @relation("EmoticonForks", fields: [parentId], references: [id], onDelete: SetNull)
  forks       Emoticon[] @relation("EmoticonForks")
  createdAt   DateTime @default(now())

  saves EmoticonSave[]
  reactions Reaction[]

  @@index([creatorId])
  @@index([communityId])
}

model EmoticonSave {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoticonId String
  emoticon   Emoticon @relation(fields: [emoticonId], references: [id], onDelete: Cascade)
  // Per-saver override of the original creator's trigger (e.g. to resolve a
  // collision with something the saver already has). Null means "use the
  // original emoticon's trigger".
  trigger    String?
  savedAt    DateTime @default(now())

  @@unique([userId, emoticonId])
}

// Per-recipient outbox. Every mutation that a user's other sessions/devices
// (and, eventually, their homeserver's federation peers) need to observe is
// appended here so clients can resume with ?cursor= instead of requiring
// everyone to be online when it happens.
model SyncEvent {
  id          String   @id @default(uuid())
  // Purely a local cursor helper for resumable sync (never exposed to other
  // homeservers) — the federated event identity is `protocolId`.
  seq         BigInt   @default(autoincrement())
  protocolId  String   @unique
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([seq])
  @@index([recipientId, seq])
}

// This server's own long-lived signing keypair (Ed25519). Generated once at
// boot if missing; outgoing federation requests are signed with the private
// key, and the public key is published at .well-known so peers can verify
// them. Singleton - always exactly one row.
model ServerIdentity {
  id         Int      @id @default(1)
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

// Discovery cache for a remote homeserver: its resolved API base URL and
// signing public key, fetched from their .well-known document. Doubles as
// the spec's "known peers" registry - re-fetched when stale rather than
// trusted forever.
model FederationPeer {
  id        String   @id @default(uuid())
  domain    String   @unique
  baseUrl   String
  publicKey String
  fetchedAt DateTime @default(now())
}

enum FederationOutboxStatus {
  PENDING // waiting for its next attempt (immediately, or at nextAttemptAt)
  IN_PROGRESS // currently being delivered - see claimedAt
  FAILED // gave up after too many attempts; not auto-retried further
}

// Durable queue for an outbound federation event (a friend request,
// conversation handshake, or message relay - NOT presence, which is
// current-state-only and gets nothing from retrying a stale push) that
// didn't deliver on its first, synchronous attempt. See
// server/src/lib/federation/outbox.ts: enqueueFederationEvent() always
// writes this row *before* attempting delivery, so a crash between "wrote
// the local DB change" and "told the peer" can never lose the event the
// way a bare try/catch around federationFetch() used to.
model FederationOutboxEvent {
  id            String                  @id @default(uuid())
  domain        String
  path          String
  body          Json
  status        FederationOutboxStatus  @default(PENDING)
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now())
  // Set when claimed by a worker (this process's background retry loop, or
  // another replica's) via a conditional UPDATE ... WHERE status=PENDING -
  // the atomicity of that single UPDATE is what stops two replicas from
  // both delivering the same event. Also used to reclaim a row whose
  // claiming process crashed mid-delivery (stale IN_PROGRESS).
  claimedAt     DateTime?
  lastError     String?
  createdAt     DateTime                @default(now())

  @@index([status, nextAttemptAt])
  @@index([domain])
}

enum NotificationTargetType {
  GLOBAL
  COMMUNITY
  CHANNEL
  CONVERSATION
}

// What a person wants to hear and see when a message arrives (#47's local half), for everything (GLOBAL) and for one community,
// channel or conversation. `sound` and `notify` are separate, and null means "no choice here: use the next level up" (a channel
// falls back to its community, then to GLOBAL; a conversation to GLOBAL), and with nothing set anywhere both are ON. Kept on the
// server so a choice follows the person to every device. The target is named by its protocolId and not checked against what the
// person can see: it is their own preference, and a stale one is only a row that never matches.
model NotificationSetting {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType NotificationTargetType
  // "" for GLOBAL: a unique key cannot include a NULL (Postgres treats NULLs as distinct), so there is no NULL here.
  targetId   String                 @default("")
  sound      Boolean?
  notify     Boolean?
  updatedAt  DateTime               @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([userId])
}
