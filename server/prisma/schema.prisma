// Federated Open-Source Communication Platform — MVP schema
//
// Single-server for now, but the shapes here are chosen so federation can be
// added later without a rewrite:
//   - All federatable objects (User, Message, Community, Emoticon, ...) use
//     ULIDs as their public/protocol ID, never the implicit DB primary key
//     semantics of another server.
//   - Identity is `username` scoped to this server's configured `domain`
//     (see src/config.ts); the full federated identity is `@username:domain`.
//   - SyncEvent is a per-recipient outbox so clients (and, later, remote
//     homeservers) can resume delivery via a cursor instead of assuming
//     everyone is online.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/Linux-glibc). The Docker image
  // (server/Dockerfile) runs on Alpine, which Prisma's own OpenSSL
  // auto-detection doesn't handle there (Alpine has no `openssl` CLI to
  // shell out to) - without this explicit target, Prisma silently generates
  // a client against the wrong engine binary and the container fails at
  // startup with an opaque "Could not parse schema engine response" error.
  // Both musl targets are needed since the image is published for both
  // amd64 and arm64 (see .github/workflows/publish-images.yml) - omitting
  // the arm64 one would only fail at container startup on that arch, not
  // at build/generate time.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PresenceStatus {
  ONLINE
  AWAY
  BUSY
  DO_NOT_DISTURB
  INVISIBLE
  OFFLINE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ConversationType {
  DM
  GROUP
}

enum ChannelType {
  TEXT
}

model User {
  id           String   @id @default(uuid())
  protocolId   String   @unique // ULID, set at creation time by application code
  username     String
  passwordHash String? // null for a remote stub - they authenticate on their own homeserver, not here
  displayName  String
  avatarUrl    String?
  bio          String?

  // Which homeserver is authoritative for this identity. Every row has one -
  // a local user's is always `config.domain`; a remote stub's is the real
  // peer domain, cached here so `@username:domain` resolves without a join.
  homeserverDomain  String
  isRemote          Boolean @default(false)
  // Cached from the peer's discovery document when this stub was created -
  // lets us build absolute URLs for remote avatars/attachments, since a
  // relative `/uploads/x` only resolves against the server that stored it.
  homeserverBaseUrl String?

  presenceStatus PresenceStatus @default(OFFLINE)
  customStatus   String?
  lastSeenAt     DateTime?

  // TOTP (RFC 6238) 2FA - null/false for every remote stub and for a local
  // user who hasn't enabled it. Stored as plaintext base32 (not hashed, unlike
  // passwordHash) because the server needs to recompute codes from it on every
  // login - there's no KMS/secrets-vault in this project to do better than
  // that, same pragmatic tradeoff most self-hosted TOTP implementations make.
  totpSecret  String?
  totpEnabled Boolean @default(false)
  // The most recent 30-second time-step a valid code was accepted on, so the
  // exact same code (or a replayed recovery code) can't be accepted twice -
  // see server/src/lib/totp.ts.
  totpLastUsedStep Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  totpRecoveryCodes   TotpRecoveryCode[]
  sentFriendRequests  FriendRequest[]       @relation("SentFriendRequests")
  recvFriendRequests  FriendRequest[]       @relation("ReceivedFriendRequests")
  friendshipsA        Friendship[]          @relation("FriendshipUser")
  friendshipsB        Friendship[]          @relation("FriendshipFriend")
  blocksMade          Block[]               @relation("BlockingUser")
  blocksReceived       Block[]              @relation("BlockedUser")
  conversationMembers ConversationMember[]
  channelReads        ChannelRead[]
  messages            Message[]
  reactions           Reaction[]
  emoticonsCreated     Emoticon[]
  emoticonSaves        EmoticonSave[]
  ownedCommunities     Community[]
  communityMemberships CommunityMember[]
  syncEvents           SyncEvent[]

  @@unique([username, homeserverDomain])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A one-time fallback code for logging in when the TOTP authenticator app
// isn't available. Hashed the same way RefreshToken.tokenHash is (sha256,
// one-way) - never stored or logged in plaintext after being shown once at
// generation time.
model TotpRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model FriendRequest {
  id          String              @id @default(uuid())
  protocolId  String              @unique
  fromUserId  String
  fromUser    User                @relation("SentFriendRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                @relation("ReceivedFriendRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  message     String?
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  resolvedAt  DateTime?

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockingUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Conversation {
  id         String           @id @default(uuid())
  protocolId String           @unique
  type       ConversationType
  title      String?
  createdAt  DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String?
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Community {
  id          String   @id @default(uuid())
  protocolId  String   @unique
  name        String
  description String?
  iconUrl     String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())

  members  CommunityMember[]
  roles    Role[]
  channels Channel[]
  bans     CommunityBan[]
  emoticons Emoticon[]
}

model Role {
  id          String   @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  position    Int      @default(0)
  permissions BigInt   @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  memberRoles MemberRole[]

  @@index([communityId])
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname    String?
  joinedAt    DateTime  @default(now())

  roles MemberRole[]

  @@unique([communityId, userId])
  @@index([userId])
}

model MemberRole {
  id       String          @id @default(uuid())
  memberId String
  member   CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
}

model CommunityBan {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

model Channel {
  id          String      @id @default(uuid())
  protocolId  String      @unique
  communityId String
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  topic       String?
  type        ChannelType @default(TEXT)
  position    Int         @default(0)
  createdAt   DateTime    @default(now())

  messages Message[]
  reads    ChannelRead[]
}

// Per-(user, channel) read cursor, mirroring ConversationMember.lastReadAt -
// a community can have several channels, and a member may have read #general
// but not #random, so this can't live on CommunityMember.
model ChannelRead {
  id         String   @id @default(uuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  protocolId     String        @unique
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id])
  content        String
  replyToId      String?
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  reactions   Reaction[]
  attachments Attachment[]

  @@index([conversationId, createdAt])
  @@index([channelId, createdAt])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Attachment {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url         String
  filename    String
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}

model Emoticon {
  id          String   @id @default(uuid())
  protocolId  String   @unique
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  trigger     String
  imageUrl    String
  allowSave   Boolean  @default(true)
  allowExport Boolean  @default(true)
  allowFork   Boolean  @default(true)
  parentId    String?
  parent      Emoticon? @relation("EmoticonForks", fields: [parentId], references: [id], onDelete: SetNull)
  forks       Emoticon[] @relation("EmoticonForks")
  createdAt   DateTime @default(now())

  saves EmoticonSave[]

  @@index([creatorId])
  @@index([communityId])
}

model EmoticonSave {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoticonId String
  emoticon   Emoticon @relation(fields: [emoticonId], references: [id], onDelete: Cascade)
  // Per-saver override of the original creator's trigger (e.g. to resolve a
  // collision with something the saver already has). Null means "use the
  // original emoticon's trigger".
  trigger    String?
  savedAt    DateTime @default(now())

  @@unique([userId, emoticonId])
}

// Per-recipient outbox. Every mutation that a user's other sessions/devices
// (and, eventually, their homeserver's federation peers) need to observe is
// appended here so clients can resume with ?cursor= instead of requiring
// everyone to be online when it happens.
model SyncEvent {
  id          String   @id @default(uuid())
  // Purely a local cursor helper for resumable sync (never exposed to other
  // homeservers) — the federated event identity is `protocolId`.
  seq         BigInt   @default(autoincrement())
  protocolId  String   @unique
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([seq])
  @@index([recipientId, seq])
}

// This server's own long-lived signing keypair (Ed25519). Generated once at
// boot if missing; outgoing federation requests are signed with the private
// key, and the public key is published at .well-known so peers can verify
// them. Singleton - always exactly one row.
model ServerIdentity {
  id         Int      @id @default(1)
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

// Discovery cache for a remote homeserver: its resolved API base URL and
// signing public key, fetched from their .well-known document. Doubles as
// the spec's "known peers" registry - re-fetched when stale rather than
// trusted forever.
model FederationPeer {
  id        String   @id @default(uuid())
  domain    String   @unique
  baseUrl   String
  publicKey String
  fetchedAt DateTime @default(now())
}

enum FederationOutboxStatus {
  PENDING // waiting for its next attempt (immediately, or at nextAttemptAt)
  IN_PROGRESS // currently being delivered - see claimedAt
  FAILED // gave up after too many attempts; not auto-retried further
}

// Durable queue for an outbound federation event (a friend request,
// conversation handshake, or message relay - NOT presence, which is
// current-state-only and gets nothing from retrying a stale push) that
// didn't deliver on its first, synchronous attempt. See
// server/src/lib/federation/outbox.ts: enqueueFederationEvent() always
// writes this row *before* attempting delivery, so a crash between "wrote
// the local DB change" and "told the peer" can never lose the event the
// way a bare try/catch around federationFetch() used to.
model FederationOutboxEvent {
  id            String                  @id @default(uuid())
  domain        String
  path          String
  body          Json
  status        FederationOutboxStatus  @default(PENDING)
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now())
  // Set when claimed by a worker (this process's background retry loop, or
  // another replica's) via a conditional UPDATE ... WHERE status=PENDING -
  // the atomicity of that single UPDATE is what stops two replicas from
  // both delivering the same event. Also used to reclaim a row whose
  // claiming process crashed mid-delivery (stale IN_PROGRESS).
  claimedAt     DateTime?
  lastError     String?
  createdAt     DateTime                @default(now())

  @@index([status, nextAttemptAt])
  @@index([domain])
}
