PORT=4000
SERVER_DOMAIN=localhost
SERVER_NAME=My Chat Server
DATABASE_URL=postgresql://chat:chat@localhost:5433/chat
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
REGISTRATION_ENABLED=true
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=8388608
CORS_ORIGIN=http://localhost:5173

# Optional - only needed to run more than one server replica. Unset (the
# default) means purely in-process presence/WebSocket delivery, which is all
# a single replica ever needs. See README "Running multiple replicas". When
# set, it also backs rate limiting's counters (below) so a fleet of replicas
# shares one budget per client instead of each replica tracking its own.
# REDIS_URL=redis://localhost:6380

# Optional - rate limiting thresholds (requests per 15-minute window, per
# client IP). Defaults shown below. AUTH_RATE_LIMIT_MAX applies specifically
# to /api/v1/auth on top of RATE_LIMIT_MAX, which covers every other route.
# See README "Rate limiting" for the trust-proxy caveat.
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10

# Optional - where uploaded files (avatars, attachments, emoticon images)
# are stored. "disk" (the default) writes to UPLOADS_DIR and serves them
# at /uploads - correct for a single replica, but each replica would only
# see its own uploads with more than one. Set to "s3" to upload to an
# S3-compatible bucket (AWS, MinIO, Cloudflare R2, DigitalOcean Spaces,
# ...) instead - the fix for that, since a bucket is shared storage every
# replica sees the same way.
# STORAGE_DRIVER=disk

# Required when STORAGE_DRIVER=s3 (ignored otherwise).
# S3_BUCKET=my-chat-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# Where the bucket is actually publicly readable from - no trailing
# slash. Can't be derived automatically: plain AWS, a CDN in front, a
# provider's own public-bucket URL, and a MinIO reverse proxy all shape
# this differently.
# S3_PUBLIC_URL_BASE=https://my-chat-uploads.s3.us-east-1.amazonaws.com

# Optional, only for a non-AWS S3-compatible provider (MinIO, R2, Spaces,
# ...) - unset talks to real AWS S3. S3_FORCE_PATH_STYLE is needed by some
# providers (notably MinIO) for path-style requests (https://host/bucket/key)
# instead of the virtual-hosted-style AWS defaults to (https://bucket.host/key).
# S3_ENDPOINT=https://s3.example-compatible.net
# S3_FORCE_PATH_STYLE=true

# Optional - whether registration checks a new password against the Have I
# Been Pwned breach corpus (only the first 5 hex chars of its SHA-1 hash are
# ever sent - see README "Password policy"). On by default. Fails open: an
# outage of that API, or an air-gapped deployment with no outbound internet,
# never blocks registration, just silently skips this extra check. Set to
# "false" to disable the outbound call outright.
# PASSWORD_BREACH_CHECK_ENABLED=true
