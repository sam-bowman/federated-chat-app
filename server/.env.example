PORT=4000
SERVER_DOMAIN=localhost
SERVER_NAME=My Chat Server
DATABASE_URL=postgresql://chat:chat@localhost:5433/chat
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
REGISTRATION_ENABLED=true
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=8388608
# Browser origins allowed to call this server, comma-separated, each a bare origin
# (scheme + host + port, no path). List every client that talks to it, e.g. the web
# client and the desktop app: CORS_ORIGIN=https://chat.example.com,http://tauri.localhost
# There is no "any origin" value: `*` is rejected at startup.
CORS_ORIGIN=http://localhost:5173

# Docker image only: by default the container refuses to start if the database named at the end of
# DATABASE_URL does not exist (a typo there used to create a new, empty database and a new federation
# identity). Set this to let the server create it on first start instead.
# CREATE_DATABASE_IF_MISSING=true

# Optional - only needed to run more than one server replica. Unset (the
# default) means purely in-process presence/WebSocket delivery, which is all
# a single replica ever needs. See docs/scaling.md "Running multiple replicas". When
# set, it also backs rate limiting's counters (below) so a fleet of replicas
# shares one budget per client instead of each replica tracking its own.
# REDIS_URL=redis://localhost:6380

# Optional - whether this server talks to other homeservers at all (default true). false makes it PRIVATE: its
# discovery document says it is not federating, every /federation/v1 request is refused, it sends nothing to another
# server, and nobody on it can add a friend, message or join a community on another server. What already exists with
# other servers is kept, and picks up again if you turn this back on. Only true/false (and 1/0, yes/no, on/off) are
# accepted: a typo stops the server rather than being guessed. See docs/deployment/private-server.md.
# FEDERATION_ENABLED=false

# Optional - limit WHICH other servers this one talks to: comma-separated exact domains (no wildcards, no https://).
# FEDERATION_ALLOWED_DOMAINS: only these, no others. FEDERATION_BLOCKED_DOMAINS: every server except these. A server that is
# not permitted is neither answered (403 federation_domain_blocked) nor contacted; what already exists with it is kept and
# waits. Unset or empty = no limit. A domain in both, or an entry that is not a domain, stops the server at startup.
# See docs/deployment/private-server.md.
# FEDERATION_ALLOWED_DOMAINS=family.example.com
# FEDERATION_BLOCKED_DOMAINS=spam.example.com

# Optional - how many reverse proxies / load balancers sit in front of this server
# (a number of hops, e.g. 1, or a comma-separated list of proxy addresses/CIDRs, or
# loopback/linklocal/uniquelocal). Unset (the default) trusts no X-Forwarded-For. Behind
# a proxy WITHOUT it, req.ip is the proxy's address and every user shares one rate-limit
# bucket. "true" and catch-all ranges are refused: they let a client pick its own
# rate-limit identity. See docs/security.md "Rate limiting".
# TRUST_PROXY=1

# Optional - rate limiting thresholds (requests per 15-minute window, per
# client IP). Defaults shown below. AUTH_RATE_LIMIT_MAX applies specifically
# to /api/v1/auth on top of RATE_LIMIT_MAX, which covers every other route.
# See docs/security.md "Rate limiting" for the trust-proxy caveat.
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10

# Optional - bcrypt work factor for new password hashes (4-31). Leave this unset:
# the default of 12 is what a real server should use, and a deployment refuses to
# start with less than 10. It exists so the test suite can hash quickly.
# BCRYPT_ROUNDS=12

# Optional - where uploaded files (avatars, attachments, emoticon images)
# are stored. "disk" (the default) writes to UPLOADS_DIR and serves them
# at /uploads - correct for a single replica, but each replica would only
# see its own uploads with more than one. Set to "s3" to upload to an
# S3-compatible bucket (AWS, MinIO, Cloudflare R2, DigitalOcean Spaces,
# ...) instead - the fix for that, since a bucket is shared storage every
# replica sees the same way.
# STORAGE_DRIVER=disk

# Required when STORAGE_DRIVER=s3 (ignored otherwise).
# S3_BUCKET=my-chat-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# Where the bucket is actually publicly readable from - no trailing
# slash. Can't be derived automatically: plain AWS, a CDN in front, a
# provider's own public-bucket URL, and a MinIO reverse proxy all shape
# this differently.
# S3_PUBLIC_URL_BASE=https://my-chat-uploads.s3.us-east-1.amazonaws.com

# Optional, only for a non-AWS S3-compatible provider (MinIO, R2, Spaces,
# ...) - unset talks to real AWS S3. S3_FORCE_PATH_STYLE is needed by some
# providers (notably MinIO) for path-style requests (https://host/bucket/key)
# instead of the virtual-hosted-style AWS defaults to (https://bucket.host/key).
# S3_ENDPOINT=https://s3.example-compatible.net
# S3_FORCE_PATH_STYLE=true

# Safety checks at startup (docker image and packaged binaries - i.e. anything
# that is not `npm run dev`). The server refuses to start if JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET or SERVER_DOMAIN is unset or still a placeholder, because the
# built-in fallbacks are public; and if the database has migrations this version does
# not know about (a newer version already migrated it). Under `npm run dev` the first is
# only a warning. These override them - for a throwaway local trial only:
# ALLOW_INSECURE_DEFAULTS=true
# ALLOW_UNKNOWN_MIGRATIONS=true

# Optional - whether registration checks a new password against the Have I
# Been Pwned breach corpus (only the first 5 hex chars of its SHA-1 hash are
# ever sent - see docs/security.md "Password policy"). On by default. Fails open: an
# outage of that API, or an air-gapped deployment with no outbound internet,
# never blocks registration, just silently skips this extra check. Set to
# "false" to disable the outbound call outright.
# PASSWORD_BREACH_CHECK_ENABLED=true
