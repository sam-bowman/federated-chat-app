{
  "name": "server",
  "private": true,
  "version": "0.18.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:binary": "npm run build && node scripts/build-binary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "registration-invites": "tsx src/registrationInvitesCli.ts",
    "admin": "tsx src/adminCli.ts",
    "docs:api": "node scripts/api-reference.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "pretest": "node ../scripts/check-node.mjs",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "pretest:coverage": "node ../scripts/check-node.mjs",
    "test:coverage": "vitest run src --coverage",
    "pretest:integration": "node ../scripts/check-node.mjs",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "pretest:integration:coverage": "node ../scripts/check-node.mjs",
    "test:integration:coverage": "vitest run -c vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.1",
    "multer": "^2.0.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "rate-limit-redis": "^6.0.1",
    "ulid": "^3.0.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.16.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "emojibase-data": "18.0.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
